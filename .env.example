# SQLite is the local preview default. A production install uses PostgreSQL 16.
DATABASE_URL=sqlite+aiosqlite:///./cdnmanager.db
# DATABASE_URL=postgresql+asyncpg://cdn:cdn@localhost:5432/cdnmanager

# Login sessions prefer Redis (about eight hours). If Redis is down or REDIS_URL
# is empty, sessions are stored in the application database instead.
REDIS_URL=redis://localhost:6379/0

PORT=8080
SEED_DEMO=true
DEMO_TELEMETRY=true

# --- Production (Cloud Run sets these; see deploy/gcp/README.md) ---
# ENVIRONMENT=production turns off the demo estate and demo telemetry, turns on
# secure cookies and JSON logs, and leaves schema changes to Alembic.
# ENVIRONMENT=production
#
# Database parts take precedence over DATABASE_URL, so the password needs no URL escaping.
# CLOUD_SQL_INSTANCE connects over the Cloud SQL Unix socket; DB_HOST/DB_PORT use TCP.
# DB_USER=cdnmanager
# DB_PASSWORD=
# DB_NAME=cdnmanager
# CLOUD_SQL_INSTANCE=my-project:asia-south1:cdnmanager-pg
# DB_HOST=
# DB_PORT=5432
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
#
# First super admin, created only while the users table is empty (12+ characters).
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_PASSWORD=
#
# Proxies in front of the app whose X-Forwarded-For entries are trusted.
# Cloud Run alone: 1. Cloud Run behind an external HTTPS load balancer: 2.
# TRUSTED_PROXY_HOPS=0
